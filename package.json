{
  "name": "gh-widget",
  "version": "1.0.0",
  "private": true,
  "description": "Self-hosted GitHub stats widget (SVG) built with Hono, locked to a single GitHub account",
  "scripts": {
    "dev": "bun run --hot dev.ts",
    "dev:vercel": "vercel dev",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@vercel/node": "^3.2.24",
    "bun-types": "^1.1.42",
    "typescript": "^5.7.2"
  }
}